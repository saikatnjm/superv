# Maintainer: saikatnjm <saikatnjm at users dot noreply dot github dot com>
# Arch Linux / Manjaro / EndeavourOS package, published on the AUR as "superv".
# Build and install from this folder:  makepkg -si
pkgname=superv
pkgver=2.1.0
pkgrel=1
pkgdesc="Clipboard, emoji and more Windows shortcuts for Linux: Super+V clipboard history, Super+. emoji panel, plain-text paste, colour picker, text from screen"
arch=('x86_64' 'aarch64')
url="https://github.com/saikatnjm/superv"
license=('MIT' 'Unicode-3.0')
depends=('gtk3' 'libx11' 'libxtst' 'python' 'python-gobject')
optdepends=('noto-fonts-emoji: colour emoji in the emoji panel'
            'tesseract: copy text from the screen (Super+Shift+T)'
            'tesseract-data-eng: English text recognition')
provides=('superdot')
conflicts=('superdot')
replaces=('superdot')
install=superv.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('d2cfe038fe71a22fa96a47f129187492b47d0aa328c0f4e3dcaee4b960213bbc')

build() {
    cd "$pkgname-$pkgver"
    make CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS" PREFIX=/usr
}

package() {
    cd "$pkgname-$pkgver"
    make install DESTDIR="$pkgdir" PREFIX=/usr
}
