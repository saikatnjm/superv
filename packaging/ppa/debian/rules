#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_build:
	dh_auto_build -- PREFIX=/usr

override_dh_auto_install:
	dh_auto_install -- PREFIX=/usr UDEVDIR=/usr/lib/udev/rules.d MODLOADDIR=/usr/lib/modules-load.d
	# Debian ships the licence in debian/copyright instead
	rm -rf debian/superv/usr/share/licenses
